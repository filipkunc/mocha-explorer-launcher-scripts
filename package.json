{
  "name": "mocha-explorer-launcher-scripts",
  "version": "0.5.0",
  "description": "Launcher scripts for the Mocha Explorer extension for VS Code",
  "author": "Holger Benl <hbenl@evandor.de>",
  "license": "MIT",
  "homepage": "https://github.com/hbenl/mocha-explorer-launcher-scripts",
  "repository": {
    "type": "git",
    "url": "https://github.com/filipkunc/mocha-explorer-launcher-scripts.git"
  },
  "bugs": {
    "url": "https://github.com/hbenl/mocha-explorer-launcher-scripts/issues"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build"
