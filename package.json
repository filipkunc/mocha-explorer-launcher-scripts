    "@vscode/test-electron": "^3.1.0",
    "vscode-test-adapter-remoting-util": "^0.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "nyc": "^18.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  }
}
